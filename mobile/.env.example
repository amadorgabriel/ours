# API REST (mesma base do server/)
EXPO_PUBLIC_API_URL=http://localhost:5280/api

# Google Sign-In — OAuth client IDs (Google Cloud Console)
# Web client ID é usado pelo SDK nativo para obter idToken
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Origem https do convite, sem sufixo /join. Ausente: o app usa projectours://join/{code}.
EXPO_PUBLIC_INVITE_BASE_URL=http://localhost:3000

{
  "expo": {
    "name": "Project Ours",
    "slug": "project-ours",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "projectours",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.projectours.app"
    },
    "android": {
      "package": "com.projectours.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F0E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F0E8",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.385042091210-d3mrb52t2jpb742oi63itqa9ucdvet46"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "googleSignIn": {
        "iosUrlScheme": "com.googleusercontent.apps.385042091210-d3mrb52t2jpb742oi63itqa9ucdvet46"
      },
      "router": {},
      "eas": {
        "projectId": "e0b15877-c8d6-4c20-abc9-791f1744c6b1"
      }
    },
    "owner": "amadorgabriel"
  }
}

# Project Ours API — production env template (VM: /etc/projectours/env)
# Copy values into the VM env file (chmod 600). Never commit real secrets.
# ASP.NET Core binds nested keys with double underscores (__).

# Runtime
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5280

# Neon Postgres (SSL required). Prefer ConnectionStrings__PostgreSQL on the VM.
# Local Windows migrations may use PROJECTOURS_CONNECTION_STRING instead — do not mix names.
ConnectionStrings__PostgreSQL=Host=<neon-host>;Database=projectours;Username=<user>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true

# JWT (SigningKey: minimum 32 characters; rotate per README "JWT rotation")
JwtSettings__SigningKey=<generate-32-plus-char-secret>
JwtSettings__Issuer=project-ours-api
JwtSettings__Audience=project-ours-clients

# Google OAuth client IDs (not secret, but keep env-driven for prod)
Authentication__Google__ClientId=<web-client-id>.apps.googleusercontent.com
Authentication__Google__AndroidClientId=<android-client-id>.apps.googleusercontent.com

# CORS — primary origin (add more with Cors__AllowedOrigins__1, __2, ...)
Cors__AllowedOrigins__0=https://ours.app
# While using Cloudflare Quick Tunnel (no custom domain), also allow the trycloudflare origin:
# Cors__AllowedOrigins__1=https://<subdomain>.trycloudflare.com

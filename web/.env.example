# Origin of the API for the Next.js rewrite only. Not sent to the browser.
# Leave NEXT_PUBLIC_API_URL empty so login stays on the web origin (cookie + Google).
OURS_API_ORIGIN=http://127.0.0.1:5280

# Optional absolute API base. Empty uses same-origin `/api` (required for Google login).
NEXT_PUBLIC_API_URL=

NEXT_PUBLIC_APP_URL=

# Link público de convite (ex.: https://ours.app)
NEXT_PUBLIC_INVITE_BASE_URL=https://ours.app

NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Cloud Console → OAuth 2.0 Client ID (Web). Required for login button.

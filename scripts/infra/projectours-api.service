[Unit]
Description=Project Ours API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/projectours/api
# Self-contained apphost (linux-x64). Do not use /usr/bin/dotnet: the VM
# shared framework store can be empty, and the muxer then exits 150.
ExecStart=/opt/projectours/api/ProjectOurs.API
EnvironmentFile=/etc/projectours/env
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
SyslogIdentifier=projectours-api

# Hardening (loopback-only binding expected via ASPNETCORE_URLS)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
